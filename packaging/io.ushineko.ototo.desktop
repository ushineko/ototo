[Desktop Entry]
Type=Application
Name=ototo
GenericName=Audio output switcher
Comment=Switch audio outputs and Bluetooth headsets by priority, with JamesDSP routing
Exec=ototo-gui
Icon=ototo
Terminal=false
Categories=AudioVideo;Audio;
Keywords=audio;sound;output;sink;bluetooth;headset;pipewire;pulseaudio;jamesdsp;
StartupNotify=true
# The basename of this file must stay io.ushineko.ototo.desktop. Fyne sets the
# Wayland app_id from the application's unique ID (shell.Options.AppID in
# internal/gui), and a Wayland compositor resolves a window's icon by matching
# that app_id to a desktop file of the same name. Renaming this file to
# ototo.desktop silently costs the taskbar icon on every Wayland session.
# StartupWMClass covers the X11 and XWayland case, where the match is on
# WM_CLASS instead.
StartupWMClass=io.ushineko.ototo
